+  // SCRATCH-V2：cloudSpan 低频高度代理——9 次 length() 选最包住 p 的包围球，
+  // 返回 (cl.y−r, 2r)。p.y 的 ±50m 抖动摊在 ~km 级球高上 → hgt 等高线消失。
+  const cloudSpan = Fn(([pImp]: [any]) => {
+    const p = pImp as any;
+    const best = float(-1e9).toVar();
+    const bottom = float(1200).toVar();
+    const height = float(1).toVar();
+    Loop(BG_CLOUD_LOOP_MAX, ({ i }: { i: number }) => {
+      If(float(i).lessThan(uCount), () => {
+        const cl = uClouds.element(int(i)).toVar();
+        const dxz = length(vec2(p.x.sub(cl.x), p.z.sub(cl.z)));
